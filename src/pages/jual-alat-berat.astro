---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BUSINESS_INFO } from '../data/businessInfo';
import { getBreadcrumbSchema, getServiceSchema } from '../utils/seo';
import { generateGeneralInquiryUrl } from '../utils/whatsapp';

const waUrl = generateGeneralInquiryUrl('Pembelian Alat Berat Baru / Bekas');

const serviceSchema = getServiceSchema({
  title: 'Jual Alat Berat untuk Berbagai Kebutuhan Proyek',
  description:
    'Cari alat berat baru atau bekas untuk proyek konstruksi, pertambangan, dan perkebunan. Ajukan kebutuhan unit, spesifikasi, dan lokasi melalui Sentra Alat Berat.',
  url: '/jual-alat-berat/',
  serviceType: 'Heavy Equipment Sales',
  image: '/images/services/jual-alat-berat.webp',
});

const breadcrumbSchema = getBreadcrumbSchema([
  { name: 'Beranda', url: '/' },
  { name: 'Jual Alat Berat', url: '/jual-alat-berat/' },
]);

const inspectionPoints = [
  {
    title: 'Mesin & Sistem Pendingin',
    desc: 'Periksa kemudahan menyalakan mesin, suara operasional, asap pembuangan, kebocoran, dan kestabilan temperatur kerja.',
  },
  {
    title: 'Sistem Hidrolik & Silinder',
    desc: 'Amati kondisi pompa hidrolik, silinder, hose, valve, serta respons gerakan boom, arm, dan bucket di bawah beban.',
  },
  {
    title: 'Undercarriage & Struktur',
    desc: 'Periksa keausan track shoe, roller, idler, sprocket, sasis, serta kesesuaian indikator jam kerja dan riwayat perawatan.',
  },
  {
    title: 'Kelistrikan & Dokumen Unit',
    desc: 'Pastikan sistem kelistrikan, starter, panel instrumen, serta kelengkapan dokumen identitas dan riwayat servis unit.',
  },
];

const quoteSteps = [
  'Tentukan jenis alat berat dan pekerjaan yang akan dilakukan.',
  'Sebutkan merek, model, kapasitas, tahun, serta kondisi yang diinginkan jika ada preferensi.',
  'Informasikan lokasi pengiriman dan target waktu penggunaan.',
  'Tanyakan harga, kondisi unit, dokumen, biaya pengiriman, serta ketentuan transaksi.',
  'Bandingkan spesifikasi dan kondisi, bukan hanya harga awal.',
];
---

<BaseLayout
  title="Jual Alat Berat Baru & Bekas Proyek - Sentra Alat Berat"
  description="Cari alat berat untuk proyek konstruksi, pertambangan, dan perkebunan. Ajukan kebutuhan unit, spesifikasi, dan lokasi melalui Sentra Alat Berat."
  jsonLd={[serviceSchema, breadcrumbSchema]}
>
  <!-- HERO -->
  <section class="relative bg-[#020617] text-white py-10 lg:py-14 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-5">
          <nav aria-label="Breadcrumb" class="text-xs text-slate-400 flex items-center gap-2">
            <a href="/" class="hover:text-white">Beranda</a>
            <span>/</span>
            <span class="text-[#fbbf24] font-semibold">Jual Alat Berat</span>
          </nav>

          <h1 class="text-[30px] leading-[34px] tracking-[-0.75px] md:text-[44px] md:leading-[48px] font-bold text-white">
            Jual Alat Berat Baru &amp; Bekas Siap Kerja
          </h1>

          <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-2xl">
            Pengadaan unit alat berat baru dan rekondisi terverifikasi untuk proyek konstruksi, galian tanah, pertambangan, dan perkebunan. Setiap unit melewati pengecekan performa mesin diesel, tekanan sistem hidrolik, fisik undercarriage, serta keabsahan dokumen kepemilikan sebelum serah terima.
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-3">
            <button
              type="button"
              data-open-rfq
              data-rfq-category="Pembelian Alat Berat (Baru / Bekas)"
              class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-[#b45309] hover:bg-[#92400e] text-white text-xs sm:text-sm font-semibold transition-colors cursor-pointer"
            >
              <span>Ajukan Kebutuhan</span>
            </button>

            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white text-xs sm:text-sm font-semibold transition-colors"
            >
              <svg aria-hidden="true" class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z" />
              </svg>
              <span>WhatsApp {BUSINESS_INFO.phoneDisplay}</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="aspect-4/3 rounded-2xl overflow-hidden border border-white/10 bg-slate-900">
            <img
              src="/images/services/jual-alat-berat.webp"
              alt="Pilihan unit excavator dan alat berat untuk kebutuhan proyek konstruksi dan pertambangan"
              width="640"
              height="480"
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PILIHAN JENIS ALAT BERAT -->
  <section class="bg-white py-10 lg:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div class="max-w-2xl space-y-2">
        <h2 class="text-[24px] leading-[32px] md:text-[32px] md:leading-[38px] font-bold text-slate-950">
          Pilihan Jenis Alat Berat
        </h2>
        <p class="text-sm text-slate-600 leading-relaxed">
          Kebutuhan setiap proyek berbeda. Berikut beberapa jenis alat berat yang umum digunakan dan dapat dijadikan titik awal pencarian:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {BUSINESS_INFO.unitTypes.map((unit) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-5 space-y-4">
            <div class="aspect-4/3 rounded-xl overflow-hidden bg-slate-100">
              <img
                src={unit.image}
                alt={unit.alt}
                width="400"
                height="300"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="space-y-1.5">
              <h3 class="text-base font-bold text-slate-950">{unit.name}</h3>
              <p class="text-xs text-slate-600 leading-relaxed">{unit.role}</p>
              <p class="text-[11px] font-medium text-slate-500 pt-1">{unit.specNote}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- APA YANG PERLU DIPERIKSA SEBELUM MEMBELI -->
  <section class="bg-slate-50 py-10 lg:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-5 space-y-4">
          <h2 class="text-[24px] leading-[32px] md:text-[32px] md:leading-[38px] font-bold text-slate-950">
            Apa yang Perlu Diperiksa Sebelum Membeli?
          </h2>
          <p class="text-sm text-slate-600 leading-relaxed">
            Jika mempertimbangkan alat berat bekas, jangan hanya menilai dari harga. Periksa kondisi mesin, sistem hidrolik, undercarriage, kelistrikan, struktur, kebocoran, jam kerja, riwayat perawatan, dan kelengkapan dokumen. Bila memungkinkan, lakukan inspeksi langsung dan pengujian fungsi dengan teknisi yang kompeten.
          </p>
          <p class="text-sm text-slate-600 leading-relaxed">
            Pastikan juga spesifikasi unit sesuai dengan medan dan beban kerja. Unit yang terlalu kecil dapat memperlambat pekerjaan, sedangkan unit yang terlalu besar dapat meningkatkan biaya transportasi dan operasional.
          </p>
        </div>

        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {inspectionPoints.map((pt) => (
            <div class="rounded-2xl bg-white border border-slate-200 p-5 space-y-2">
              <h3 class="text-sm font-bold text-slate-950">{pt.title}</h3>
              <p class="text-xs text-slate-600 leading-relaxed">{pt.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CARA MEMINTA PENAWARAN & SINGLE WHATSAPP CTA -->
  <section class="bg-white py-10 lg:py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <h2 class="text-[24px] leading-[32px] md:text-[32px] md:leading-[38px] font-bold text-slate-950">
        Cara Meminta Penawaran
      </h2>

      <ol class="grid grid-cols-1 gap-3">
        {quoteSteps.map((step, i) => (
          <li class="rounded-xl bg-slate-50 border border-slate-200 p-4 flex items-start gap-3.5 text-xs sm:text-sm text-slate-700">
            <span class="w-6 h-6 rounded-full bg-[#b45309] text-white font-bold text-xs flex items-center justify-center shrink-0">
              {i + 1}
            </span>
            <span class="pt-0.5 leading-relaxed">{step}</span>
          </li>
        ))}
      </ol>

      <div class="rounded-2xl bg-[#020617] text-white p-6 sm:p-8 space-y-5">
        <div class="space-y-2">
          <h3 class="text-lg sm:text-xl font-bold text-white">
            Tanyakan Ketersediaan Alat Berat
          </h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Untuk menanyakan ketersediaan alat berat, hubungi Sentra Alat Berat melalui WhatsApp {BUSINESS_INFO.phoneDisplay}. Ketersediaan unit dan harga perlu dikonfirmasi saat permintaan diajukan.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button
            type="button"
            data-open-rfq
            data-rfq-category="Pembelian Alat Berat (Baru / Bekas)"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-[#b45309] hover:bg-[#92400e] text-white text-xs sm:text-sm font-semibold transition-colors cursor-pointer"
          >
            <span>Ajukan Kebutuhan</span>
          </button>

          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white text-xs sm:text-sm font-semibold transition-colors"
          >
            <svg aria-hidden="true" class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z" />
            </svg>
            <span>WhatsApp {BUSINESS_INFO.phoneDisplay}</span>
          </a>
        </div>

        <div class="pt-3 border-t border-white/10 flex flex-wrap gap-4 text-xs text-slate-400">
          <span>Layanan terkait:</span>
          <a href="/spare-part-alat-berat/" class="text-[#fbbf24] hover:underline">Jual Spare Part</a>
          <a href="/service-alat-berat/" class="text-[#fbbf24] hover:underline">Service Alat Berat</a>
          <a href="/sewa-alat-berat/" class="text-[#fbbf24] hover:underline">Sewa Alat Berat</a>
          <a href="/informasi-alat-berat/tips-membeli-excavator-bekas/" class="text-[#fbbf24] hover:underline">Tips Membeli Excavator Bekas</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
