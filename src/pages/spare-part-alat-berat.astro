---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BUSINESS_INFO } from '../data/businessInfo';
import { getBreadcrumbSchema, getServiceSchema } from '../utils/seo';
import { generateGeneralInquiryUrl } from '../utils/whatsapp';

const waUrl = generateGeneralInquiryUrl('Pencarian Spare Part Alat Berat');

const serviceSchema = getServiceSchema({
  title: 'Jual Spare Part Alat Berat Sesuai Kebutuhan Unit',
  description:
    'Cari spare part alat berat berdasarkan merek, model, atau nomor part. Hubungi Sentra Alat Berat untuk mengajukan kebutuhan suku cadang.',
  url: '/spare-part-alat-berat/',
  serviceType: 'Heavy Equipment Spare Parts',
  image: '/images/services/spare-part-alat-berat.webp',
});

const breadcrumbSchema = getBreadcrumbSchema([
  { name: 'Beranda', url: '/' },
  { name: 'Jual Spare Part Alat Berat', url: '/spare-part-alat-berat/' },
]);

const partGroups = [
  {
    title: 'Filter Oli, Bahan Bakar & Udara',
    desc: 'Komponen filtrasi untuk menjaga kebersihan sirkulasi pelumas, sistem bahan bakar diesel, dan asupan udara mesin.',
  },
  {
    title: 'Komponen Mesin Diesel & Sistem Pendingin',
    desc: 'Suku cadang ruang bakar, gasket, water pump, radiator, thermostat, dan komponen pendukung mesin diesel.',
  },
  {
    title: 'Hydraulic Pump, Hose, Seal & Valve',
    desc: 'Komponen sistem hidrolik bertekanan tinggi termasuk pompa utama, seal kit silinder, selang hidrolik, dan control valve.',
  },
  {
    title: 'Komponen Undercarriage',
    desc: 'Track shoe, track link, carrier roller, track roller, idler, dan sprocket untuk kestabilan gerak unit crawler.',
  },
  {
    title: 'Komponen Kelistrikan, Sensor & Starter',
    desc: 'Alternator, motor starter, sensor tekanan/temperatur, wiring, dan komponen elektrikal sesuai model unit.',
  },
  {
    title: 'Attachment & Komponen Pendukung',
    desc: 'Bucket teeth, adapter, cutting edge, pin, bushing, serta perlengkapan kerja sesuai kompatibilitas alat berat.',
  },
];

const orderChecklist = [
  'Merek dan model alat berat.',
  'Nomor seri/PIN unit jika tersedia.',
  'Nama komponen atau nomor part.',
  'Jumlah yang dibutuhkan.',
  'Foto label atau komponen lama.',
  'Lokasi pengiriman dan waktu kebutuhan.',
];
---

<BaseLayout
  title="Jual Spare Part Alat Berat Nomor Part - Sentra Alat Berat"
  description="Cari spare part alat berat berdasarkan merek, model, atau nomor part. Hubungi Sentra Alat Berat untuk mengajukan kebutuhan suku cadang."
  jsonLd={[serviceSchema, breadcrumbSchema]}
>
  <!-- HERO -->
  <section class="relative bg-[#020617] text-white py-10 lg:py-14 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-5">
          <nav aria-label="Breadcrumb" class="text-xs text-slate-400 flex items-center gap-2">
            <a href="/" class="hover:text-white">Beranda</a>
            <span>/</span>
            <span class="text-[#fbbf24] font-semibold">Spare Part Alat Berat</span>
          </nav>

          <h1 class="text-[30px] leading-[34px] tracking-[-0.75px] md:text-[44px] md:leading-[48px] font-bold text-white">
            Jual Spare Part Alat Berat Sesuai Kebutuhan Unit
          </h1>

          <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-2xl">
            Spare part yang tepat berperan penting dalam menjaga performa, keandalan, dan waktu operasional alat berat. Kesalahan memilih komponen dapat menyebabkan pemasangan tidak sesuai, gangguan kerja, atau waktu tunggu perbaikan menjadi lebih panjang. Sentra Alat Berat membantu Anda mengajukan kebutuhan suku cadang berdasarkan informasi unit dan komponen yang diperlukan.
          </p>

          <div class="pt-2">
            <button
              type="button"
              data-open-rfq
              data-rfq-category="Pencarian Spare Part Alat Berat"
              class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-[#b45309] hover:bg-[#92400e] text-white text-xs sm:text-sm font-semibold transition-colors cursor-pointer"
            >
              <span>Ajukan Kebutuhan</span>
            </button>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="aspect-4/3 rounded-2xl overflow-hidden border border-white/10 bg-slate-900">
            <img
              src="/images/services/spare-part-alat-berat.webp"
              alt="Komponen hidrolik, silinder, hose, dan suku cadang alat berat"
              width="640"
              height="480"
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- JENIS SPARE PART YANG DAPAT DICARI -->
  <section class="bg-white py-10 lg:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div class="max-w-2xl space-y-2">
        <h2 class="text-[24px] leading-[32px] md:text-[32px] md:leading-[38px] font-bold text-slate-950">
          Jenis Spare Part yang Dapat Dicari
        </h2>
        <p class="text-sm text-slate-600 leading-relaxed">
          Kebutuhan suku cadang bergantung pada merek, model, nomor seri, tahun, dan konfigurasi unit. Beberapa kelompok komponen yang umum dicari meliputi:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {partGroups.map((group) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 space-y-2">
            <h3 class="text-base font-bold text-slate-950">{group.title}</h3>
            <p class="text-xs text-slate-600 leading-relaxed">{group.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CARA MENGHINDARI SALAH BELI & INFORMASI PEMESANAN -->
  <section class="bg-slate-50 py-10 lg:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-6 space-y-4">
          <h2 class="text-[24px] leading-[32px] md:text-[32px] md:leading-[38px] font-bold text-slate-950">
            Cara Menghindari Salah Beli Spare Part
          </h2>
          <p class="text-sm text-slate-600 leading-relaxed">
            Cara paling aman adalah mencocokkan nomor part dan data unit. Siapkan merek, model, nomor seri atau PIN unit jika tersedia, nomor part lama, dan foto komponen.
          </p>
          <p class="text-sm text-slate-600 leading-relaxed">
            Jika nomor part tidak diketahui, berikan foto dari beberapa sisi dan jelaskan lokasi komponen pada unit. Jangan mengandalkan kemiripan bentuk saja karena komponen yang terlihat serupa belum tentu kompatibel.
          </p>
        </div>

        <div class="lg:col-span-6 rounded-2xl bg-white border border-slate-200 p-6 sm:p-8 space-y-4">
          <h3 class="text-base sm:text-lg font-bold text-slate-950">
            Informasi yang Sebaiknya Dikirim Saat Memesan
          </h3>
          <ol class="space-y-3 text-xs sm:text-sm text-slate-700">
            {orderChecklist.map((item, idx) => (
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-amber-50 text-[#b45309] font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">
                  {idx + 1}
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA PENGAJUAN SPARE PART -->
  <section class="bg-white py-10 lg:py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl bg-[#020617] text-white p-6 sm:p-8 space-y-5">
        <div class="space-y-2">
          <h2 class="text-lg sm:text-xl font-bold text-white">
            Ajukan Pencarian Spare Part Alat Berat
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Hubungi Sentra Alat Berat melalui WhatsApp {BUSINESS_INFO.phoneDisplay} untuk mengajukan pencarian spare part. Harga, merek, kondisi barang, garansi, dan ketersediaan harus dikonfirmasi sebelum pemesanan.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button
            type="button"
            data-open-rfq
            data-rfq-category="Pencarian Spare Part Alat Berat"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-[#b45309] hover:bg-[#92400e] text-white text-xs sm:text-sm font-semibold transition-colors cursor-pointer"
          >
            <span>Ajukan Kebutuhan</span>
          </button>

          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full border border-slate-300 bg-white hover:bg-slate-100 text-slate-800 text-xs sm:text-sm font-semibold transition-colors"
          >
            <span>Konsultasi via WhatsApp</span>
          </a>
        </div>

        <div class="pt-3 border-t border-white/10 flex flex-wrap gap-4 text-xs text-slate-400">
          <span>Baca juga:</span>
          <a href="/informasi-alat-berat/cara-memilih-spare-part-alat-berat/" class="text-[#fbbf24] hover:underline">Cara Memilih Spare Part Alat Berat yang Tepat</a>
          <a href="/service-alat-berat/" class="text-[#fbbf24] hover:underline">Service &amp; Perbaikan Alat Berat</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
