  const guides: Record<string, string> = {
    jual: 'Siapkan: Jenis unit, merek/model, kapasitas, kondisi & lokasi proyek',
    part: 'Siapkan: Merek, model, nomor seri PIN unit, nomor part & foto komponen',
    service: 'Siapkan: Jenis unit, lokasi saat ini, gejala kerusakan & riwayat servis',
    sewa: 'Siapkan: Jenis unit, lokasi proyek, tanggal mulai, durasi & operator',
  };

  serviceSelect?.addEventListener('change', () => {
    const val = serviceSelect.value;
    if (summaryEl && guides[val]) {
      summaryEl.textContent = guides[val];
    }
  });
</script>
