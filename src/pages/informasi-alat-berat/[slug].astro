---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BUSINESS_INFO } from '../../data/businessInfo';
import {
  getAllPublishedArticles,
  type SeoArticle,
} from '../../data/articlesData';
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildFaqSchema,
} from '../../utils/seo';
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';

export async function getStaticPaths() {
  const articles = getAllPublishedArticles();
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: SeoArticle;
}

const { article } = Astro.props;
const canonicalPath = `/informasi-alat-berat/${article.slug}/`;
const waUrl = generateGeneralInquiryUrl(`Konsultasi: ${article.h1}`);

const jsonLd = [
  buildBreadcrumbSchema([
    { name: 'Beranda', path: '/' },
    { name: 'Informasi Alat Berat', path: '/informasi-alat-berat/' },
    { name: article.title, path: canonicalPath },
  ]),
  buildArticleSchema({
    headline: article.h1,
    description: article.metaDescription,
    path: canonicalPath,
    image: article.image,
    datePublished: article.datePublished,
    dateModified: article.dateModified,
    author: article.author,
  }),
  buildFaqSchema(article.faqs.map((f) => ({ q: f.question, a: f.answer }))),
];

const allArticles = getAllPublishedArticles();
const relatedArticles = allArticles.filter((a) => a.slug !== article.slug).slice(0, 3);
---

<BaseLayout
  title={`${article.title} - Sentra Alat Berat`}
  description={article.metaDescription}
  canonicalPath={canonicalPath}
  ogType="article"
  jsonLd={jsonLd}
>
  <!-- ARTICLE HERO HEADER -->
  <section class="bg-[#020617] text-white py-12 lg:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="text-xs text-slate-400 mb-6 flex flex-wrap items-center gap-2">
        <a href="/" class="hover:text-white transition-colors">Beranda</a>
        <span>/</span>
        <a href="/informasi-alat-berat/" class="hover:text-white transition-colors">Informasi Alat Berat</a>
        <span>/</span>
        <span class="text-[#fbbf24] font-medium truncate max-w-xs">{article.title}</span>
      </nav>

      <div class="space-y-4">
        <div class="flex flex-wrap items-center gap-3 text-xs">
          <span class="px-3 py-1 rounded-full bg-amber-500/20 text-[#fbbf24] font-semibold border border-amber-500/30">
            {article.category}
          </span>
          <time datetime={article.datePublished} class="text-slate-400">
            Dipublikasikan: {article.datePublished}
          </time>
          <span class="text-slate-500">•</span>
          <span class="text-slate-400">{article.author}</span>
        </div>

        <h1 class="text-[28px] leading-[36px] tracking-[-0.7px] md:text-[40px] md:leading-[46px] md:tracking-[-1px] font-bold text-white">
          {article.h1}
        </h1>

        <p class="text-sm md:text-base text-slate-300 leading-relaxed">
          {article.leadParagraph}
        </p>
      </div>
    </div>
  </section>

  <!-- MAIN ARTICLE BODY -->
  <article class="bg-white py-10 lg:py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <!-- Featured Image -->
      <figure class="rounded-2xl overflow-hidden border border-slate-200 bg-slate-100">
        <img
          src={article.image}
          alt={article.imageAlt}
          width="900"
          height="500"
          class="w-full aspect-16/9 object-cover"
          loading="eager"
        />
        <figcaption class="px-5 py-3 text-xs text-slate-500 bg-slate-50 border-t border-slate-200/80">
          {article.imageCaption}
        </figcaption>
      </figure>

      <!-- Content Sections with H2 and H3 -->
      {article.sections.map((sec) => (
        <section class="space-y-5">
          <h2 class="text-[22px] leading-[30px] md:text-[28px] md:leading-[36px] font-bold text-slate-950">
            {sec.heading}
          </h2>

          <div class="space-y-4 text-sm sm:text-base text-slate-700 leading-relaxed">
            {sec.content.map((p) => (
              <p>{p}</p>
            ))}
          </div>

          {sec.subsections && sec.subsections.map((sub) => (
            <div class="mt-4 p-5 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-2">
              <h3 class="text-base font-bold text-slate-900">{sub.heading}</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{sub.content}</p>
            </div>
          ))}

          {sec.highlights && (
            <div class="rounded-2xl bg-amber-50/70 border border-amber-200/80 p-5 space-y-2">
              <span class="text-xs font-bold text-[#b45309] uppercase tracking-wider block">
                Poin Penting Operasional:
              </span>
              <ul class="space-y-2 text-xs sm:text-sm text-slate-800 list-disc pl-5">
                {sec.highlights.map((hl) => (
                  <li>{hl}</li>
                ))}
              </ul>
            </div>
          )}
        </section>
      ))}

      <!-- TABEL LOKASI PROYEK SE-INDONESIA -->
      <section class="space-y-5 pt-4">
        <div class="space-y-2">
          <h2 class="text-[22px] leading-[30px] md:text-[28px] md:leading-[36px] font-bold text-slate-950">
            {article.locationTable.heading}
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            {article.locationTable.description}
          </p>
        </div>

        <div class="overflow-x-auto rounded-2xl border border-slate-200 shadow-xs">
          <table class="w-full text-left text-xs sm:text-sm text-slate-700 border-collapse">
            <thead class="bg-slate-900 text-white text-[11px] sm:text-xs uppercase tracking-wider">
              <tr>
                <th class="px-4 py-3.5 font-semibold">Wilayah / Pulau</th>
                <th class="px-4 py-3.5 font-semibold">Hub Kota Utama</th>
                <th class="px-4 py-3.5 font-semibold">Sektor Proyek Dominan</th>
                <th class="px-4 py-3.5 font-semibold">Moda Mobilisasi</th>
                <th class="px-4 py-3.5 font-semibold whitespace-nowrap">Estimasi Waktu</th>
                <th class="px-4 py-3.5 font-semibold whitespace-nowrap">Status Unit</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 bg-white">
              {article.locationTable.rows.map((row, idx) => (
                <tr class={idx % 2 === 0 ? 'bg-white' : 'bg-slate-50/60'}>
                  <td class="px-4 py-3 font-bold text-slate-950 whitespace-nowrap">
                    {row.region}
                  </td>
                  <td class="px-4 py-3 text-slate-600 min-w-[160px]">
                    {row.hubCity}
                  </td>
                  <td class="px-4 py-3 text-slate-600 min-w-[200px]">
                    {row.dominantProjects}
                  </td>
                  <td class="px-4 py-3 text-slate-700 min-w-[170px]">
                    <span class="inline-flex px-2 py-0.5 rounded-md bg-slate-100 text-slate-800 text-[11px] font-medium">
                      {row.mobilizationMode}
                    </span>
                  </td>
                  <td class="px-4 py-3 font-semibold text-slate-900 whitespace-nowrap">
                    {row.estimatedLeadTime}
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap">
                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                      {row.unitAvailability}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- FAQ SECTION (SCHEMA COMPLIANT) -->
      <section class="space-y-6 pt-4">
        <div class="space-y-2">
          <h2 class="text-[22px] leading-[30px] md:text-[28px] md:leading-[36px] font-bold text-slate-950">
            Pertanyaan yang Sering Diajukan (FAQ)
          </h2>
          <p class="text-xs sm:text-sm text-slate-600">
            Informasi penting terkait syarat sewa, mobilisasi unit, dan dukungan teknis di lapangan.
          </p>
        </div>

        <div class="space-y-4">
          {article.faqs.map((faq) => (
            <div class="rounded-2xl border border-slate-200 p-5 bg-white space-y-2">
              <h3 class="text-sm sm:text-base font-bold text-slate-950">
                {faq.question}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- INTERNAL LINKING STRATEGIS -->
      <section class="rounded-2xl bg-slate-50 border border-slate-200 p-6 space-y-4">
        <h3 class="text-sm font-bold text-slate-950 uppercase tracking-wider">
          Rujukan Layanan Sentra Alat Berat Terkait
        </h3>
        <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700">
          {article.internalLinks.map((link) => (
            <li class="flex items-start gap-2">
              <svg aria-hidden="true" class="w-4 h-4 text-[#b45309] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
              <span>
                {link.context}{' '}
                <a href={link.href} class="font-bold text-[#b45309] hover:underline">
                  {link.anchorText}
                </a>.
              </span>
            </li>
          ))}
        </ul>
      </section>

      <!-- BOTTOM CTA BOX -->
      <section class="rounded-2xl bg-[#020617] text-white p-6 sm:p-8 space-y-5">
        <div class="space-y-2">
          <h2 class="text-lg sm:text-xl font-bold text-white">
            Konsultasi Kebutuhan Alat Berat untuk Proyek Anda
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Hubungi tim teknis Sentra Alat Berat di {BUSINESS_INFO.phoneDisplay}. Sampaikan spesifikasi unit, durasi sewa, dan koordinat lokasi kerja untuk estimasi penawaran resmi.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button
            type="button"
            data-open-rfq
            data-rfq-category={article.category}
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-[#b45309] hover:bg-[#92400e] text-white text-xs sm:text-sm font-semibold transition-colors cursor-pointer shadow-lg"
          >
            <span>Ajukan Kebutuhan</span>
          </button>

          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white text-xs sm:text-sm font-semibold transition-colors shadow-lg"
          >
            <svg aria-hidden="true" class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z" />
            </svg>
            <span>WhatsApp {BUSINESS_INFO.phoneDisplay}</span>
          </a>
        </div>
      </section>

      <!-- RELATED ARTICLES -->
      {relatedArticles.length > 0 && (
        <section class="space-y-4 pt-6 border-t border-slate-200">
          <h3 class="text-base font-bold text-slate-950">
            Panduan &amp; Informasi Terkait Lainnya
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {relatedArticles.map((rel) => (
              <a
                href={`/informasi-alat-berat/${rel.slug}/`}
                class="group block p-4 rounded-xl border border-slate-200 hover:border-[#b45309] bg-white transition-colors"
              >
                <div class="aspect-16/10 rounded-lg overflow-hidden bg-slate-100 mb-2.5">
                  <img
                    src={rel.image}
                    alt={rel.imageAlt}
                    width="280"
                    height="175"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </div>
                <h4 class="text-xs font-bold text-slate-900 group-hover:text-[#b45309] transition-colors line-clamp-2">
                  {rel.title}
                </h4>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</BaseLayout>
