---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  keywords?: string | string[];
  author?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  image = '/images/og/default-og.jpg',
  type = 'website',
  keywords,
  author = 'Sentra Alat Berat',
  jsonLd,
  noindex = false,
} = Astro.props;

const siteName = 'Sentra Alat Berat';
const domain = 'https://sewaalatberat.com';

const sanitizedRawTitle = title
  .replace(/\s*[|—–]\s*/g, ' - ')
  .replace(/\s+/g, ' ')
  .trim();
const formattedTitle = sanitizedRawTitle.includes(siteName)
  ? sanitizedRawTitle
  : `${sanitizedRawTitle} - ${siteName}`;

const rawDesc = description
  .replace(/\s*[|—–]\s*/g, ', ')
  .replace(/\s+/g, ' ')
  .trim();
const sanitizedDescription = rawDesc.endsWith('.') ? rawDesc : `${rawDesc}.`;

const fullImageUrl = image.startsWith('http')
  ? image
  : `${domain}${image.startsWith('/') ? image : `/${image}`}`;

const rawPath = canonical || Astro.url.pathname;
const cleanPathname = rawPath.startsWith('http')
  ? new URL(rawPath).pathname
  : rawPath.startsWith('/')
    ? rawPath
    : `/${rawPath}`;
const normalizedPathname =
  cleanPathname.endsWith('/') || cleanPathname.includes('.')
    ? cleanPathname
    : `${cleanPathname}/`;
const canonicalUrl = `${domain}${normalizedPathname}`;

const defaultKeywords = [
  'jual alat berat',
  'jual spare part alat berat',
  'service alat berat',
  'sewa alat berat',
  'excavator bekas',
  'harga sewa excavator',
  'sentra alat berat malang',
];
const keywordsString = Array.isArray(keywords)
  ? keywords.join(', ')
  : keywords || defaultKeywords.join(', ');

const formattedJsonLd = jsonLd
  ? Array.isArray(jsonLd)
    ? {
        '@context': 'https://schema.org',
        '@graph': jsonLd.map((item) => {
          if (item && item['@context']) {
            const { '@context': _, ...rest } = item;
            return rest;
          }
          return item;
        }),
      }
    : jsonLd
  : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
<meta name="format-detection" content="telephone=no" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#020617" />
<meta name="application-name" content="Sentra Alat Berat" />

<meta
  name="robots"
  content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>
<meta name="googlebot" content="index, follow" />

<link rel="canonical" href={canonicalUrl} />

<title>{formattedTitle}</title>
<meta name="title" content={formattedTitle} />
<meta name="description" content={sanitizedDescription} />
<meta name="keywords" content={keywordsString} />
<meta name="author" content={author} />
<meta name="publisher" content={siteName} />
{type === 'article' && <meta property="article:author" content={author} />}
{type === 'article' && <meta property="article:publisher" content={siteName} />}

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={formattedTitle} />
<meta property="og:description" content={sanitizedDescription} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="id_ID" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={formattedTitle} />
<meta name="twitter:description" content={sanitizedDescription} />
<meta name="twitter:image" content={fullImageUrl} />

{formattedJsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(formattedJsonLd)} />
)}
