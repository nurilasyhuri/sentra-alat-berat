---
import { BUSINESS_INFO } from '../../data/businessInfo';
---

<footer class="bg-[#020617] text-slate-400 pt-16 pb-12 lg:py-20 font-sans">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 pb-10 border-b border-white/10">
      <!-- Col 1-4: Brand & Mission -->
      <div class="lg:col-span-4 space-y-4">
        <a href="/" class="inline-flex items-center gap-3 select-none">
          <span class="w-9 h-9 rounded-full bg-white/10 border border-white/20 text-white font-bold text-xs flex items-center justify-center">
            SA
          </span>
          <div class="flex flex-col">
            <div class="flex items-center gap-1.5 text-base font-bold tracking-tight leading-none">
              <span class="text-white">SENTRA</span>
              <span class="text-[#fbbf24]">ALAT BERAT</span>
            </div>
            <span class="text-[10px] text-slate-400 font-medium leading-none mt-1">
              Semua Kebutuhan Alat Berat, dalam Satu Sentra
            </span>
          </div>
        </a>

        <p class="text-xs text-slate-400 leading-relaxed max-w-sm">
          Pusat layanan satu pintu untuk mencari alat berat yang ingin dibeli, mengajukan pencarian spare part sesuai nomor part atau foto, berkonsultasi mengenai service dan perbaikan, serta menyewa unit sesuai kebutuhan proyek.
        </p>

        <!-- Plain Contact Text Rows (Honoring Owner Single-WhatsApp-CTA Invariant) -->
        <div class="space-y-2 text-xs text-slate-300 pt-1">
          <div class="flex items-center gap-2.5">
            <svg aria-hidden="true" class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span>Telepon / WhatsApp: <strong class="text-white font-semibold">{BUSINESS_INFO.phoneDisplay}</strong></span>
          </div>
          <div class="flex items-center gap-2.5">
            <svg aria-hidden="true" class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>Alamat: <strong class="text-white font-semibold">{BUSINESS_INFO.address.formatted}</strong></span>
          </div>
          <div class="flex items-center gap-2.5 text-slate-400">
            <svg aria-hidden="true" class="w-4 h-4 text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>Konfirmasi ketersediaan, spesifikasi &amp; ketentuan sebelum transaksi</span>
          </div>
        </div>
      </div>

      <!-- Col 5-7: Layanan & Panduan -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="text-xs font-bold text-white">Layanan &amp; Informasi</h3>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li><a href="/jual-alat-berat/" class="hover:text-white transition-colors">Jual Alat Berat Baru &amp; Bekas</a></li>
          <li><a href="/spare-part-alat-berat/" class="hover:text-white transition-colors">Jual Spare Part Alat Berat</a></li>
          <li><a href="/service-alat-berat/" class="hover:text-white transition-colors">Service &amp; Perbaikan Alat Berat</a></li>
          <li><a href="/sewa-alat-berat/" class="hover:text-white transition-colors">Sewa Alat Berat untuk Proyek</a></li>
          <li><a href="/informasi-alat-berat/" class="hover:text-white transition-colors">Pusat Informasi Alat Berat</a></li>
          <li><a href="/informasi-alat-berat/harga-sewa-excavator/" class="hover:text-white transition-colors">Faktor Harga Sewa Excavator</a></li>
          <li><a href="/informasi-alat-berat/tips-membeli-excavator-bekas/" class="hover:text-white transition-colors">Tips Membeli Excavator Bekas</a></li>
          <li><a href="/informasi-alat-berat/cara-memilih-spare-part-alat-berat/" class="hover:text-white transition-colors">Cara Memilih Spare Part Tepat</a></li>
        </ul>
      </div>

      <!-- Col 8-9: Sektor & Jenis Unit -->
      <div class="lg:col-span-2 space-y-3">
        <h3 class="text-xs font-bold text-white">Sektor &amp; Jenis Unit</h3>
        <ul class="space-y-2.5 text-xs">
          <li>
            <div class="font-semibold text-white">Excavator &amp; Bulldozer</div>
            <div class="text-[11px] text-slate-400">Galian tanah &amp; pembukaan lahan</div>
          </li>
          <li>
            <div class="font-semibold text-white">Wheel Loader &amp; Grader</div>
            <div class="text-[11px] text-slate-400">Pemuatan material &amp; perataan</div>
          </li>
          <li>
            <div class="font-semibold text-white">Vibro Roller &amp; Dump Truck</div>
            <div class="text-[11px] text-slate-400">Pemadatan &amp; angkut material</div>
          </li>
          <li>
            <div class="font-semibold text-white">Konstruksi &amp; Tambang</div>
            <div class="text-[11px] text-slate-400">Perkebunan &amp; kegiatan industri</div>
          </li>
        </ul>
      </div>

      <!-- Col 10-12: Lokasi & Cakupan Layanan -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="text-xs font-bold text-white">Lokasi &amp; Layanan</h3>
        <div class="space-y-3">
          <div class="rounded-xl border border-white/10 bg-white/[0.03] p-4 space-y-1.5">
            <div class="flex items-center gap-1.5 text-xs font-bold text-white">
              <svg aria-hidden="true" class="w-3.5 h-3.5 text-[#fbbf24] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span>Sentra Alat Berat Malang</span>
            </div>
            <p class="text-[11px] text-slate-400 leading-relaxed">
              Puncak Buring Indah, Kedungkandang, Malang
            </p>
          </div>

          <div class="rounded-xl border border-white/10 bg-white/[0.03] p-4 space-y-1.5">
            <div class="flex items-center gap-1.5 text-xs font-bold text-white">
              <svg aria-hidden="true" class="w-3.5 h-3.5 text-[#fbbf24] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              <span>Layanan Satu Pintu</span>
            </div>
            <p class="text-[11px] text-slate-400 leading-relaxed">
              Jual Unit, Spare Part, Service &amp; Sewa Alat Berat
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright & Legal Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>&copy; {new Date().getFullYear()} Sentra Alat Berat (SentraAlatBerat.com). Hak Cipta Dilindungi.</p>
      <div class="flex flex-wrap items-center justify-center gap-5 text-xs text-slate-400">
        <a href="/tentang-kami/" class="hover:text-white transition-colors">Tentang Kami</a>
        <a href="/kontak/" class="hover:text-white transition-colors">Kontak</a>
        <a href="/kebijakan-privasi/" class="hover:text-white transition-colors">Kebijakan Privasi</a>
        <a href="/ketentuan-layanan/" class="hover:text-white transition-colors">Ketentuan Layanan</a>
      </div>
    </div>
  </div>
</footer>
